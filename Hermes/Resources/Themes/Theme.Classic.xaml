<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- TEMA: CLASSIC - MODO CLARO PROFESIONAL -->
    <!-- Elegante, simple, formal, sin saturación -->
    <!-- Fondos blancos con detalles azules -->
    <!-- ========================================== -->

    <!-- COLORES BASE (para DropShadowEffect y otras propiedades Color) -->
    <Color x:Key="BackgroundDarkestColor">#7b7368</Color>      <!-- Gris cálido oscuro SIDEBAR -->
    <Color x:Key="BackgroundDarkColor">#8b8378</Color>         <!-- Gris cálido SIDEBAR -->
    <Color x:Key="BackgroundMediumColor">#ffffff</Color>       <!-- BLANCO PURO para tablas/panels -->
    <Color x:Key="BackgroundMediumLightColor">#ffffff</Color>  <!-- Blanco puro -->
    <Color x:Key="PrimaryColorValue">#5a8db5</Color>           <!-- Azul solo para botones -->
    <Color x:Key="PrimaryDarkColorValue">#4a7ba7</Color>       <!-- Azul oscuro botones -->
    <Color x:Key="PrimaryLightColorValue">#7ba5c9</Color>      <!-- Azul claro botones -->
    <Color x:Key="SuccessColorValue">#6b9b7f</Color>           <!-- Verde suave -->
    <Color x:Key="InfoColorValue">#5a8db5</Color>              <!-- Azul información -->
    <Color x:Key="WarningColorValue">#d9a566</Color>           <!-- Ámbar claro -->
    <Color x:Key="DangerColorValue">#c96b66</Color>            <!-- Rojo suave -->

    <!-- Fondos BLANCOS y CREMA (TODO blanco/crema, SIN AZUL) -->
    <SolidColorBrush x:Key="BackgroundDarkest" Color="#7b7368"/>   <!-- Gris cálido oscuro SIDEBAR -->
    <SolidColorBrush x:Key="BackgroundDark" Color="#8b8378"/>      <!-- Gris cálido SIDEBAR -->
    <SolidColorBrush x:Key="BackgroundMedium" Color="#ffffff"/>    <!-- BLANCO para tablas/panels -->
    <SolidColorBrush x:Key="BackgroundCharcoal" Color="#ffffff"/>  <!-- Blanco puro -->
    <SolidColorBrush x:Key="BackgroundLight" Color="#ffffff"/>     <!-- Blanco puro -->
    <SolidColorBrush x:Key="BackgroundLightColor" Color="#fafaf8"/><!-- Crema muy claro -->
    <SolidColorBrush x:Key="BackgroundGrayColor" Color="#fafaf8"/> <!-- Crema muy claro -->

    <!-- Azul Corporativo (Color principal - Acentos SUTILES) -->
    <SolidColorBrush x:Key="PrimaryColor" Color="{StaticResource PrimaryColorValue}"/>
    <SolidColorBrush x:Key="PrimaryDarkColor" Color="{StaticResource PrimaryDarkColorValue}"/>
    <SolidColorBrush x:Key="PrimaryDeeperColor" Color="#3a6a8f"/>    <!-- Azul medio -->
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#7ba5c9"/>     <!-- Azul muy claro -->

    <!-- Colores de acción (suaves) -->
    <SolidColorBrush x:Key="InfoColor" Color="#5a8db5"/>             <!-- Azul información -->
    <SolidColorBrush x:Key="InfoHoverColor" Color="#4a7ba7"/>        <!-- Azul hover -->
    <SolidColorBrush x:Key="SuccessColor" Color="#6b9b7f"/>          <!-- Verde suave -->
    <SolidColorBrush x:Key="SuccessHoverColor" Color="#5a8a6e"/>     <!-- Verde hover -->
    <SolidColorBrush x:Key="WarningColor" Color="#d9a566"/>          <!-- Ámbar claro -->
    <SolidColorBrush x:Key="WarningHoverColor" Color="#c99455"/>     <!-- Ámbar hover -->
    <SolidColorBrush x:Key="DangerColor" Color="#c96b66"/>           <!-- Rojo suave -->
    <SolidColorBrush x:Key="DangerHoverColor" Color="#b85a55"/>      <!-- Rojo hover -->

    <!-- Colores de texto (NEGRO para modo claro) -->
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#000000"/>      <!-- Texto principal NEGRO -->
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#2c2c2c"/>    <!-- Texto secundario gris muy oscuro -->
    <SolidColorBrush x:Key="TextMutedColor" Color="#666666"/>        <!-- Texto apagado gris -->
    <SolidColorBrush x:Key="TextDarkColor" Color="#000000"/>         <!-- Texto oscuro NEGRO -->
    <SolidColorBrush x:Key="TextAccentColor" Color="#5a8db5"/>       <!-- Texto con acento azul suave -->
    <SolidColorBrush x:Key="TextSuccessColor" Color="#6b9b7f"/>      <!-- Texto éxito verde -->
    <SolidColorBrush x:Key="TextDangerColor" Color="#c96b66"/>       <!-- Texto peligro rojo -->
    <SolidColorBrush x:Key="TextOnPrimaryColor" Color="White"/>      <!-- Texto sobre azul (blanco) -->

    <!-- Colores para sidebar (GRIS CÁLIDO) -->
    <SolidColorBrush x:Key="DarkColor" Color="#8b8378"/>             <!-- Gris cálido sidebar -->
    <SolidColorBrush x:Key="DarkHoverColor" Color="#7b7368"/>        <!-- Gris cálido oscuro hover -->
    <SolidColorBrush x:Key="SidebarColor" Color="#8b8378"/>          <!-- Gris cálido sidebar -->

    <!-- Bordes (grises muy sutiles) -->
    <SolidColorBrush x:Key="BorderColor" Color="#e0e0e0"/>           <!-- Gris muy claro para bordes -->
    <SolidColorBrush x:Key="BorderLightColor" Color="#f0f0f0"/>      <!-- Gris ultra claro -->

    <!-- ========================================== -->
    <!-- DEGRADADOS SUTILES -->
    <!-- ========================================== -->

    <!-- Degradado principal (azul corporativo suave) -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource PrimaryColorValue}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryDarkColorValue}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryColorValue}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryDarkColorValue}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado para sidebar (GRIS CÁLIDO) -->
    <LinearGradientBrush x:Key="DarkGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7b7368" Offset="0"/>
        <GradientStop Color="#8b8378" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DarkGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7b7368" Offset="0"/>
        <GradientStop Color="#8b8378" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado sidebar vertical (gris cálido) -->
    <LinearGradientBrush x:Key="SidebarGradient" x:Shared="False" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8b8378" Offset="0"/>
        <GradientStop Color="#7b7368" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado medio (blanco a crema muy sutil) -->
    <LinearGradientBrush x:Key="MediumGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#fafaf8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado éxito (verde suave) -->
    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource SuccessColorValue}" Offset="0"/>
        <GradientStop Color="#5a8a6e" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado gris cálido -->
    <LinearGradientBrush x:Key="DeepBlueGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8b8378" Offset="0"/>
        <GradientStop Color="#7b7368" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado azul claro suave -->
    <LinearGradientBrush x:Key="LightBlueGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource PrimaryLightColorValue}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryColorValue}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado para cards (blanco a crema muy sutil) -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#fafaf8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado diagonal para fondo principal (blanco puro a crema muy claro) -->
    <LinearGradientBrush x:Key="BackgroundDiagonalGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#fafaf8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Degradado con efecto sutil para login branding (gris cálido) -->
    <LinearGradientBrush x:Key="LoginBrandingGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8b8378" Offset="0"/>
        <GradientStop Color="#7b7368" Offset="0.5"/>
        <GradientStop Color="#8b8378" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
